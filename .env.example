# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# The values below are local development throwaways, safe in version control.
# Anything marked GENERATE must be produced locally and never committed,
# never pasted into a chat, and never reused between environments.
#
# After the subtree graft this splits into apps/api/.env and apps/web/.env;
# until then one file at the root is enough.

# ---------------------------------------------------------------- database
# Host is "postgres" from inside Compose, "localhost" from your machine.
DATABASE_URL=postgresql://fileexplorer:localdev@localhost:5432/file_explorer

# The suite creates and drops this database itself. Never point it at a
# database holding anything you care about.
TEST_DATABASE_URL=postgresql://fileexplorer:localdev@localhost:5432/file_explorer_test

# ---------------------------------------------------------------- api
# Debug is off unless this is explicitly set. It is never set in production.
FLASK_DEBUG=1

# Comma separated, exact origins, no wildcard. An empty value rejects every
# cross-origin request, which is the correct default.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# GENERATE:  openssl rand -hex 32
SECRET_KEY=

# There is no JWT_SECRET_KEY. D-21 replaced the JWT with an opaque session id
# in a table, so nothing is signed: the credential is 32 random bytes and the
# database holds their SHA-256. Nothing to rotate, nothing to pin, and logout
# is a DELETE rather than a request that the browser forget something.

# Invariant I7 — see docs/ARCHITECTURE.md §4.
MAX_TREE_DEPTH=64
MAX_NODES_PER_USER=50000

# ---------------------------------------------------------------- web
# Vite only exposes variables prefixed VITE_ to the browser. Never put a
# secret behind that prefix — it is compiled into the bundle and public.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Session cookie. There is no development actor any more: `DEV_ACTOR_ID` was
# deleted with the change that made `require_actor()` read a session, because
# keeping both sources of identity fails open whichever order they are read in.
# Sign in through POST /api/v1/auth/login like everything else does.
#
# Secure is on by default and off only where there is no HTTPS.
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=Lax

# How many proxies sit in front of the app. 0 means none. It decides whether
# X-Forwarded-For is trusted, and the rate limiter keys on the result -- too
# low and every caller behind a balancer shares one bucket, too high and each
# caller picks their own.
TRUST_PROXY_HOPS=0

# The origin a browser actually addresses, when it is not the page's own.
# Empty is correct for the intended deployment: vercel.json rewrites /api to
# the API service, so the browser only ever talks to one origin, the session
# cookie is same-site, and CORS never enters into it.
#
# Set this only if the two halves are ever split across domains again, and
# then AUTH_COOKIE_SAMESITE has to become None -- which create_app will tell
# you, by refusing to start.
PUBLIC_API_ORIGIN=
