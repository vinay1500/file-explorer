# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# The values below are local development throwaways, safe in version control.
# Anything marked GENERATE must be produced locally and never committed,
# never pasted into a chat, and never reused between environments.
#
# After the subtree graft this splits into apps/api/.env and apps/web/.env;
# until then one file at the root is enough.

# ---------------------------------------------------------------- database
# Host is "postgres" from inside Compose, "localhost" from your machine.
DATABASE_URL=postgresql://fileexplorer:localdev@localhost:5432/file_explorer

# The suite creates and drops this database itself. Never point it at a
# database holding anything you care about.
TEST_DATABASE_URL=postgresql://fileexplorer:localdev@localhost:5432/file_explorer_test

# ---------------------------------------------------------------- api
# Debug is off unless this is explicitly set. It is never set in production.
FLASK_DEBUG=1

# Comma separated, exact origins, no wildcard. An empty value rejects every
# cross-origin request, which is the correct default.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# GENERATE:  openssl rand -hex 32
# Two different values. Rotating one must not invalidate the other.
SECRET_KEY=
JWT_SECRET_KEY=

# Cookie settings. Secure=1 requires HTTPS, so it stays 0 for local http.
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_TOKEN_MINUTES=15

# Invariant I7 — see docs/ARCHITECTURE.md §4.
MAX_TREE_DEPTH=64
MAX_NODES_PER_USER=50000

# ---------------------------------------------------------------- web
# Vite only exposes variables prefixed VITE_ to the browser. Never put a
# secret behind that prefix — it is compiled into the bundle and public.
VITE_API_BASE_URL=http://localhost:5000/api/v1
